# ========================================
# CONFIGURACIÓN DEL SISTEMA DE INFORMES
# ========================================

# Base de datos MySQL
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=1963
DB_NAME=sistema_informes
DB_PORT=3306

# Configuración del servidor
PORT=3000
NODE_ENV=development

# Configuración de sesiones
SESSION_SECRET=tu_clave_secreta_muy_segura_aqui_2024
SESSION_MAX_AGE=86400000

# Configuración JWT
JWT_SECRET=sistema_informes_jwt_secret_key_2025_super_segura
JWT_EXPIRES_IN=24h

# Configuración de archivos
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# Configuración de seguridad
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_TIME=900000

# Configuración de correo (para notificaciones futuras)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
