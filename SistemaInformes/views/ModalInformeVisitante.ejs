<!-- Modal de solo lectura para visitar -->
<div class="modal fade" id="modalInformeVisitante" tabindex="-1" aria-labelledby="modalInformeVisitanteLabel" aria-hidden="true">
  <div class="modal-dialog modal-xl modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="modalInformeVisitanteLabel"><b>INFORME (Solo Lectura)</b></h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
      </div>
      <div class="modal-body px-4 py-4">
        <!-- Usar elementos de solo lectura: <p> o inputs con readonly -->
        <div class="row mb-2">
          <div class="col-md-6 mb-2">
            <label class="form-label"><b>Nombre de quien envía:</b></label>
            <p id="v_nombreRemitente" class="form-control-plaintext"></p>
          </div>
          <div class="col-md-6 mb-2">
            <label class="form-label"><b>Fecha:</b></label>
            <p id="v_fechaEnvio" class="form-control-plaintext"></p>
          </div>
        </div>

        <div class="row mb-2">
          <div class="col-md-6 mb-2">
            <label class="form-label"><b>Área:</b></label>
            <p id="v_area" class="form-control-plaintext"></p>
          </div>
          <div class="col-md-6 mb-2">
            <label class="form-label"><b>Sector al que beneficia:</b></label>
            <p id="v_sector" class="form-control-plaintext"></p>
          </div>
        </div>

        <div class="row mb-2">
          <div class="col-md-6 mb-2">
            <label class="form-label"><b>Colonia o comunidad:</b></label>
            <p id="v_colonia" class="form-control-plaintext"></p>
          </div>
          <div class="col-md-6 mb-2">
            <label class="form-label"><b>Lugar de actividad:</b></label>
            <p id="v_lugar" class="form-control-plaintext"></p>
          </div>
        </div>

        <div class="row mb-2">
          <div class="col-md-6 mb-2">
            <label class="form-label"><b>Tipo de actividad / unidad de medida:</b></label>
            <p id="v_tipo" class="form-control-plaintext"></p>
          </div>
          <div class="col-md-6 mb-2">
            <label class="form-label"><b>Número de beneficiarios:</b></label>
            <p id="v_beneficiarios" class="form-control-plaintext"></p>
          </div>
        </div>

        <div class="row mb-2">
          <div class="col-md-6 mb-2">
            <label class="form-label"><b>Monto generado por la actividad (si aplica):</b></label>
            <p id="v_monto" class="form-control-plaintext"></p>
          </div>
          <div class="col-md-6 mb-2">
            <label class="form-label"><b>¿Cuál fue el monto invertido en la actividad?</b></label>
            <p id="v_montoInvertido" class="form-control-plaintext"></p>
          </div>
        </div>

        <div class="row mb-2">
          <div class="col-md-6 mb-2">
            <label class="form-label"><b>Evidencia fotográfica:</b></label>
            <div id="v_evidencia" class="d-flex gap-2 flex-wrap"></div>
          </div>
          <div class="col-md-3 mb-2 text-center d-flex flex-column align-items-center justify-content-center">
            <label class="form-label w-100 text-center" style="white-space: normal;"><b>¿Responde a una solicitud de la ciudadanía?</b></label>
            <p id="v_solicitudCiudadania" class="form-control-plaintext text-center"></p>
          </div>
          <div class="col-md-3 mb-2 text-center d-flex flex-column align-items-center justify-content-center">
            <label class="form-label w-100 text-center" style="white-space: normal;"><b>¿Pertenece la actividad a los procedimientos de su área?</b></label>
            <p id="v_procedimientosArea" class="form-control-plaintext text-center"></p>
          </div>
        </div>

        <div class="mb-2">
          <label class="form-label"><b>Descripción de la actividad:</b></label>
          <p id="v_descripcion" class="form-control-plaintext"></p>
        </div>
        <div class="mb-2">
          <label class="form-label"><b>Observaciones:</b></label>
          <p id="v_observaciones" class="form-control-plaintext"></p>
        </div>
        <div class="mb-2 text-center">
          <label class="form-label" style="color: #a12424; width: 100%; display: block;"><b>Comentarios sobre el informe:</b></label>
          <p id="v_comentarios" class="form-control-plaintext text-center" style="color: #a12424; font-weight: bold;"></p>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
      </div>
    </div>
  </div>
</div>
