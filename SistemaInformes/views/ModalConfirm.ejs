<!-- Modal de confirmación reutilizable -->
<div class="modal fade" id="modalConfirm" tabindex="-1" aria-labelledby="modalConfirmLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="modalConfirmLabel"><b>Confirmar acción</b></h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
      </div>
      <div class="modal-body">
        <p id="modalConfirmMessage">¿Estás seguro?</p>
      </div>
      <div class="modal-footer">
  <button type="button" class="btn btn-success" id="modalConfirmCancel">Cancelar</button>
        <button type="button" class="btn btn-danger" id="modalConfirmOk">Confirmar</button>
      </div>
    </div>
  </div>
</div>
