<!-- Encabezado del generar informe -->
<div class="text-center mb-4 mt-4" style="padding: 0 20px;">
  <h2 style="color: #a12424; font-weight: bold; margin: 1.5rem 0;">
    <i class="bi bi-file-earmark-plus me-2"></i>Creando nuevo informe
  </h2>
</div>

<div class="form-scroll-container w-100" style="padding: 0 30px; margin-bottom: 120px; min-height: calc(100vh - 200px);">
  <form style="color: #111;" id="formularioInforme" enctype="multipart/form-data" method="post" action="/informes/crear">
    
    <!-- Fecha -->
    <div class="row mb-4">
      <div class="col-md-6">
        <label for="fechaActividad" class="form-label"><b>Fecha:</b></label>
        <input type="date" class="form-control" id="fechaActividad" name="fecha_actividad" required>
      </div>
    </div>

    <!-- Área -->
    <div class="row mb-4">
      <div class="col-md-6">
        <label for="area" class="form-label"><b>Área:</b></label>
        <select class="form-select" id="area" name="area_id" required>
          <option value="">Selecciona...</option>
          <% if (areas && areas.length > 0) { %>
              <% areas.forEach(area => { %>
                  <option value="<%= area.id %>"><%= area.nombre %></option>
              <% }) %>
          <% } %>
        </select>
      </div>
    </div>

    <!-- Nombre de Director / Coordinador / Jefe de Área -->
    <div class="row mb-4">
      <div class="col-12">
        <label for="nombreDirector" class="form-label"><b>Nombre de Director / Coordinador / Jefe de Área:</b></label>
        <input type="text" class="form-control" id="nombreDirector" name="nombre_director" placeholder="Nombre del responsable" required>
      </div>
    </div>

    <!-- Lugar de Actividad -->
    <div class="row mb-4">
      <div class="col-md-6">
        <label for="lugar" class="form-label"><b>Lugar de Actividad: <span style="color: red;">*</span></b></label>
        <input type="text" class="form-control" id="lugar" name="lugar_actividad" placeholder="Ubicación donde se realizó la actividad" required>
      </div>
      <div class="col-md-6">
        <label for="colonia" class="form-label"><b>Colonia o Comunidad:</b></label>
        <input type="text" class="form-control" id="colonia" name="colonia_comunidad" placeholder="Colonia o comunidad">
      </div>
    </div>

    <!-- Tipo de Actividad / Unidad de Medida y Cantidad -->
    <div class="row mb-4">
      <div class="col-md-6">
        <label for="tipoActividad" class="form-label"><b>Tipo de Actividad / Unidad de Medida: <span style="color: red;">*</span></b></label>
        <input type="text" class="form-control" id="tipoActividad" name="tipo_actividad" placeholder="Ej: Capacitación, Reunión, Evento" required>
      </div>
      <div class="col-md-6">
        <label for="cantidad" class="form-label"><b>Cantidad:</b></label>
        <input type="number" class="form-control" id="cantidad" name="cantidad" min="0" placeholder="0">
      </div>
    </div>

    <!-- Descripción de la Actividad -->
    <div class="row mb-4">
      <div class="col-12">
        <label for="descripcion" class="form-label"><b>Descripción de la Actividad: <span style="color: red;">*</span></b></label>
        <textarea class="form-control" id="descripcion" name="descripcion_actividad" rows="4" 
                  placeholder="Describe detalladamente la actividad realizada..." required style="resize: vertical;"></textarea>
      </div>
    </div>

    <!-- Sector al que Beneficia -->
    <div class="row mb-4">
      <div class="col-12">
        <label for="sector" class="form-label"><b>Sector al que Beneficia:</b></label>
        <input type="text" class="form-control" id="sector" name="sector_beneficia" placeholder="Ej: Educación, Salud, Infraestructura">
      </div>
    </div>

    <!-- Número de Beneficiarios -->
    <div class="row mb-4">
      <div class="col-md-6">
        <label for="beneficiarios" class="form-label"><b>Número de Beneficiarios:</b></label>
        <input type="number" class="form-control" id="beneficiarios" name="numero_beneficiarios" min="0" placeholder="0">
      </div>
      <div class="col-md-6">
        <label for="monto" class="form-label"><b>Si la Actividad Genera un Ingreso Colocar Monto:</b></label>
        <div class="input-group">
          <span class="input-group-text">$</span>
          <input type="number" class="form-control" id="monto" name="monto_generado" min="0" step="0.01" placeholder="0.00">
        </div>
      </div>
    </div>

    <!-- Preguntas de Sí/No -->
    <div class="row mb-4">
      <div class="col-md-6">
        <label for="procedimientosArea" class="form-label"><b>¿Pertenece la Actividad a los Procedimientos de su Área?</b></label>
        <select class="form-select" id="procedimientosArea" name="pertenece_procedimientos_area">
          <option value="">Selecciona...</option>
          <option value="1">Sí</option>
          <option value="0">No</option>
        </select>
      </div>
      <div class="col-md-6">
        <label for="solicitudCiudadania" class="form-label"><b>¿La Actividad Responde a una Solicitud de la Ciudadanía?</b></label>
        <select class="form-select" id="solicitudCiudadania" name="responde_solicitud_ciudadania">
          <option value="">Selecciona...</option>
          <option value="1">Sí</option>
          <option value="0">No</option>
        </select>
      </div>
    </div>

    <!-- Evidencia Fotográfica -->
    <div class="row mb-4">
      <div class="col-12">
        <label for="evidencia" class="form-label"><b>Evidencia Fotográfica:</b></label>
        <input class="form-control" type="file" id="evidencia" name="evidencia_fotografica" accept="image/*" multiple>
        <small class="form-text text-muted">Puedes seleccionar múltiples imágenes (opcional)</small>
      </div>
    </div>

    <!-- Observaciones -->
    <div class="row mb-5">
      <div class="col-12">
        <label for="observaciones" class="form-label"><b>Observaciones:</b></label>
        <textarea class="form-control" id="observaciones" name="observaciones" rows="3" 
                  placeholder="Observaciones adicionales..." style="resize: vertical;"></textarea>
      </div>
    </div>

    <!-- Botones de acción con espaciado mejorado -->
    <div class="row">
      <div class="col-12">
        <div class="d-flex justify-content-center gap-3 flex-wrap" style="margin-bottom: 80px;">
          <button type="button" class="btn btn-success px-4 py-2" onclick="guardarInforme()" style="min-width: 140px;">
            <i class="bi bi-floppy me-2"></i>Guardar Borrador
          </button>
          <button type="button" class="btn btn-primary px-4 py-2" onclick="enviarInforme()" style="min-width: 140px;">
            <i class="bi bi-send me-2"></i>Enviar Informe
          </button>
          <button type="button" class="btn btn-danger px-4 py-2" onclick="cancelarInforme()" style="min-width: 140px;">
            <i class="bi bi-x-circle me-2"></i>Cancelar
          </button>
        </div>
      </div>
    </div>
  </form>
</div>

<!-- Botón flotante de inicio con posición mejorada -->
<div class="position-fixed bottom-0 end-0 p-4" style="z-index: 1000;">
  <a href="/inicio-usuario" class="btn btn-inicio btn-lg rounded-pill shadow-lg">
    <i class="bi bi-house-door-fill me-2"></i>Inicio
  </a>
</div>

<script>
  // Establecer fecha actual por defecto
  document.addEventListener('DOMContentLoaded', function() {
    const fechaInput = document.getElementById('fechaActividad');
    const today = new Date().toISOString().split('T')[0];
    fechaInput.value = today;
  });

  // Función para guardar informe como borrador
  function guardarInforme() {
    console.log('🔵 Guardando informe como borrador...');
    
    // Validar solo campos obligatorios según el manual
    const camposObligatorios = [
      'fechaActividad', 'area', 'nombreDirector', 'lugar', 'tipoActividad', 'descripcion'
    ];
    
    let camposFaltantes = [];
    camposObligatorios.forEach(campo => {
      const elemento = document.getElementById(campo);
      if (elemento && !elemento.value) {
        camposFaltantes.push(elemento.labels[0]?.textContent || campo);
      }
    });
    
    if (camposFaltantes.length > 0) {
      alert('Por favor completa los siguientes campos obligatorios:\n• ' + camposFaltantes.join('\n• '));
      return;
    }
    
    try {
      // Recopilar datos del formulario
      const formData = new FormData(document.getElementById('formularioInforme'));
      formData.append('estado', 'borrador');

      console.log('✅ FormData preparado, enviando al servidor...');

      // Enviar al servidor usando fetch (multipart/form-data)
      fetch('/informes/crear', {
        method: 'POST',
        body: formData,
        credentials: 'same-origin'
      })
      .then(res => {
        console.log('📨 Respuesta recibida - Status:', res.status);
        return res.text().then(text => ({ status: res.status, text: text }));
      })
      .then(({ status, text }) => {
        console.log('📄 Texto de respuesta:', text.substring(0, 200));
        try {
          const json = JSON.parse(text);
          if (json.success) {
            alert('✅ Informe guardado como borrador exitosamente');
            console.log('✅ Respuesta exitosa:', json);
            setTimeout(() => window.location.href = '/historial', 1000);
          } else {
            alert('❌ No se pudo guardar el informe: ' + (json.message || 'Error desconocido'));
            console.error('❌ Error en respuesta:', json);
          }
        } catch (parseErr) {
          console.error('❌ No se pudo parsear JSON:', parseErr);
          alert('❌ Error del servidor: ' + text.substring(0, 100));
        }
      })
      .catch(err => {
        console.error('❌ Error de red:', err);
        alert('❌ No se pudo conectar con el servidor: ' + err.message);
      });
    } catch (err) {
      console.error('❌ Error en guardarInforme:', err);
      alert('❌ Error: ' + err.message);
    }
  }

  // Función para enviar informe
  function enviarInforme() {
    console.log('Enviando informe...');
    
    // Validar solo campos obligatorios según el manual
    const camposObligatorios = [
      'fechaActividad', 'area', 'nombreDirector', 'lugar', 'tipoActividad', 'descripcion'
    ];
    
    let camposFaltantes = [];
    camposObligatorios.forEach(campo => {
      const elemento = document.getElementById(campo);
      if (elemento && !elemento.value) {
        camposFaltantes.push(elemento.labels[0]?.textContent || campo);
      }
    });
    
    if (camposFaltantes.length > 0) {
      alert('Por favor completa los siguientes campos obligatorios:\n• ' + camposFaltantes.join('\n• '));
      return;
    }
    
    confirmModal('¿Estás seguro de que deseas enviar el informe? Una vez enviado no podrás modificarlo.').then(async confirmed => {
      if (!confirmed) return;

      try {
        // Primero, guardar el informe como borrador (si no tiene ID)
        const formData = new FormData(document.getElementById('formularioInforme'));
        formData.append('estado', 'borrador');

        const saveRes = await fetch('/informes/crear', {
          method: 'POST',
          body: formData,
          credentials: 'same-origin'
        });

        const saveJson = await saveRes.json();
        
        if (!saveJson.success) {
          alert('No se pudo guardar el informe: ' + (saveJson.message || 'Error del servidor'));
          return;
        }

        // Ahora enviar el informe (cambiar estado a "enviado")
        const informeId = saveJson.informeId;
        const enviarRes = await fetch(`/api/informes/${informeId}/enviar`, {
          method: 'PUT',
          headers: {
            'Content-Type': 'application/json'
          },
          credentials: 'same-origin'
        });

        const enviarJson = await enviarRes.json();
        
        if (enviarJson.success) {
          alert('Informe enviado exitosamente para revisión');
          console.log('Informe enviado:', enviarJson);
          setTimeout(() => { window.location.href = '/historial'; }, 1500);
        } else {
          alert('No se pudo enviar el informe: ' + (enviarJson.message || 'Error del servidor'));
          console.error('Error enviando:', enviarJson);
        }
      } catch (err) {
        console.error('Error:', err);
        alert('Error: ' + err.message);
      }
    });
  }

  // Función para cancelar informe
  function cancelarInforme() {
    confirmModal('¿Estás seguro de que deseas cancelar? Se perderán todos los cambios no guardados.').then(confirmed => {
      if (!confirmed) return;
      document.getElementById('formularioInforme').reset();
      
      // Restablecer fecha actual
      const fechaInput = document.getElementById('fechaActividad');
      const today = new Date().toISOString().split('T')[0];
      fechaInput.value = today;
      
      alert('Formulario cancelado y reiniciado');
    });
  }

  // Función auxiliar para mostrar mensajes (si existe el sistema de toasts)
  function mostrarToast(mensaje, tipo = 'info') {
    console.log(`${tipo.toUpperCase()}: ${mensaje}`);
    // Aquí se integraría con el sistema de toasts si existe
  }
</script>