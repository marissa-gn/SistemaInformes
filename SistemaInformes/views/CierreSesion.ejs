<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sesión Finalizada - Sistema de Informes</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/styles.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
</head>
<body class="d-flex align-items-center justify-content-center min-vh-100" style="background: linear-gradient(135deg, #f8f9fa, #e9ecef);">
    <div class="container text-center">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">
                <div class="card shadow-lg border-0" style="border-radius: 20px; overflow: hidden;">
                    <div class="card-body p-5">
                        <!-- Imagen de cierre de sesión -->
                        <div class="mb-4">
                            <img src="/Img/CierreSesion.jgp.jpg" alt="Sesión Finalizada" 
                                 class="img-fluid rounded-circle shadow-sm" 
                                 style="width: 120px; height: 120px; object-fit: cover;">
                        </div>
                        
                        <!-- Título principal -->
                        <h1 class="card-title h2 mb-3" style="color: #7c2323; font-weight: bold;">
                            <i class="bi bi-check-circle-fill text-success me-2"></i>
                            Sesión Finalizada
                        </h1>
                        
                        <!-- Mensaje descriptivo -->
                        <p class="card-text text-muted mb-4 lead">
                            Tu sesión ha sido cerrada exitosamente. 
                            <br>
                            Gracias por usar el Sistema de Informes.
                        </p>
                        
                        <!-- Información adicional -->
                        <div class="alert alert-success border-0 mb-4" style="background: rgba(40, 167, 69, 0.1);">
                            <i class="bi bi-shield-check text-success me-2"></i>
                            <strong>Sesión segura:</strong> Todos tus datos han sido protegidos.
                        </div>
                        
                        <!-- Botones de acción -->
                        <div class="d-flex gap-3 justify-content-center flex-wrap">
                            <a href="/inicioSesion" class="btn btn-primary btn-lg px-5 py-3" 
                               style="background: linear-gradient(135deg, #7c2323, #a12424); border: none; border-radius: 50px; font-weight: 600;">
                                <i class="bi bi-box-arrow-in-right me-2"></i>
                                Iniciar Sesión
                            </a>
                        </div>
                        
                        <!-- Información del sistema -->
                        <div class="mt-4 pt-3 border-top">
                            <small class="text-muted">
                                <i class="bi bi-clock me-1"></i>
                                Sesión cerrada el <%= new Date().toLocaleDateString('es-MX', { 
                                    weekday: 'long', 
                                    year: 'numeric', 
                                    month: 'long', 
                                    day: 'numeric',
                                    hour: '2-digit',
                                    minute: '2-digit'
                                }) %>
                            </small>
                        </div>
                    </div>
                    
                    <!-- Footer del card -->
                    <div class="card-footer bg-light text-center py-3" style="border: none;">
                        <small class="text-muted">
                            © 2025 Ayuntamiento de Atlacomulco. Sistema de Informes.
                        </small>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Scripts para bloquear navegación y control total -->
    <script>
        // Prevenir ir atrás en el historial
        history.pushState(null, null, location.href);
        window.onpopstate = function () {
            history.go(1);
        };
        
        // Bloquear teclas de navegación y atajos
        document.addEventListener('keydown', function(e) {
            // Bloquear F5 (refresh)
            if (e.key === 'F5') {
                e.preventDefault();
                return false;
            }
            
            // Bloquear Ctrl+R (refresh)
            if (e.ctrlKey && e.key === 'r') {
                e.preventDefault();
                return false;
            }
            
            // Bloquear Ctrl+F5 (hard refresh)
            if (e.ctrlKey && e.key === 'F5') {
                e.preventDefault();
                return false;
            }
            
            // Bloquear Alt+Left (back)
            if (e.altKey && e.key === 'ArrowLeft') {
                e.preventDefault();
                return false;
            }
            
            // Bloquear Alt+Right (forward)
            if (e.altKey && e.key === 'ArrowRight') {
                e.preventDefault();
                return false;
            }
            
            // Bloquear Backspace (back) cuando no está en input
            if (e.key === 'Backspace' && e.target.tagName !== 'INPUT' && e.target.tagName !== 'TEXTAREA') {
                e.preventDefault();
                return false;
            }
        });
        
        // Bloquear clic derecho
        document.addEventListener('contextmenu', function(e) {
            e.preventDefault();
            return false;
        });
        
        // Bloquear selección de texto
        document.addEventListener('selectstart', function(e) {
            e.preventDefault();
            return false;
        });
        
        // Mensaje si intentan cerrar la pestaña
        window.addEventListener('beforeunload', function(e) {
            e.preventDefault();
            e.returnValue = 'Su sesión ha sido cerrada. Use el botón "Iniciar Sesión" para continuar.';
            return 'Su sesión ha sido cerrada. Use el botón "Iniciar Sesión" para continuar.';
        });
        
        // Limpiar cualquier dato de sesión local
        if (typeof(Storage) !== "undefined") {
            localStorage.clear();
            sessionStorage.clear();
        }
        
        console.log(' Pantalla de cierre de sesión bloqueada - Solo se puede salir con el botón');
    </script>
    
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>