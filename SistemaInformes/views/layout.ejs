<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title || 'Sistema de Informes' %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/styles.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
</head>
<body<% if (title === 'Informes') { %> class="informes-view"<% } else if (title === 'Inicio') { %> class="inicio-bg"<% } %>>
    <div class="d-flex flex-column min-vh-100" style="min-height:100vh; height:100vh;">
        <nav class="navbar navbar-expand-lg navbar-main px-3 py-0">
            <div class="container-fluid flex-nowrap">
                <span class="navbar-brand">Ayuntamiento de Atlacomulco</span>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainMenu" aria-controls="mainMenu" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainMenu">
                    <ul class="navbar-nav ms-auto mb-2 mb-lg-0 d-flex flex-row align-items-center gap-2">
                        <li class="nav-item"><a class="nav-link fw-bold" href="/informes">Ver informes</a></li>
                        <li class="nav-item"><a class="nav-link fw-bold" href="/estadisticas">Estadísticas</a></li>
                        <li class="nav-item dropdown">
                            <a class="nav-link fw-bold dropdown-toggle" href="#" id="configDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">Configuración</a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="/usuarios">Usuarios</a></li>
                                <li><a class="dropdown-item" href="/areas">Áreas</a></li>
                            </ul>
                        </li>
                    </ul>
                    <button class="btn btn-danger btn-logout ms-lg-3" onclick="cerrarSesion()"><i class="bi bi-x-circle"></i> Cerrar sesión</button>
                </div>
            </div>
        </nav>

        <div class="d-flex flex-row flex-grow-1 layout-row">

            <!-- BARRA LATERAL UNIFICADA -->
            <aside s  class="sidebar-logo d-flex flex-column align-items-center justify-content-between">
                <div class="w-100 d-flex flex-column align-items-center">
                    <%- include('partials/userBadge') %>
                    <img src="/Img/logo.jpg" class="logo img-fluid mx-auto d-block mb-2" alt="Logo Atlacomulco">
                <% if (title === 'Usuarios') { %>
                <div class="busqueda-usuarios d-flex flex-column align-items-center gap-1 w-100" style="margin-top: 0.2rem;">
                    <h5 class="fw-bold text-dark text-center mb-1" style="font-size:1em;">Filtrar usuarios</h5>
                    <div class="w-100 d-flex flex-column gap-1" style="margin-bottom:0;">
                        <select class="form-select" id="area-filter" style="font-size:0.95em;">
                            <option value="">Todas las áreas</option>
                            <option value="1">Tecnologías de la Información</option>
                            <option value="2">Finanzas y Contabilidad</option>
                            <option value="3">Recursos Humanos</option>
                            <option value="4">Mercadotecnia</option>
                            <option value="5">Departamento de Logística</option>
                        </select>
                        <select class="form-select" id="rol-filter" style="font-size:0.95em;">
                            <option value="">Todos los roles</option>
                            <option value="1">Administrador</option>
                            <option value="2">Capturista</option>
                            <option value="3">Visitante</option>
                        </select>
                        <input class="form-control" type="text" id="nombre-filter" placeholder="Buscar por nombre, apellido o usuario" style="font-size:0.95em;">
                        <button class="btn btn-buscar w-100" type="button" onclick="buscarUsuarios()" style="font-size:0.95em; padding:0.3rem 0.7rem;">
                            <i class="bi bi-search"></i> Buscar
                        </button>
                        <button class="btn btn-secondary w-100" type="button" onclick="limpiarFiltros()" style="font-size:0.85em; padding:0.2rem 0.5rem;">
                            <i class="bi bi-arrow-clockwise"></i> Limpiar
                        </button>
                    </div>
                </div>
                <% } %>
				 <% if (title === 'Áreas') { %>
                <div class="busqueda-usuarios d-flex flex-column align-items-center gap-1 w-100" style="margin-top: 0.2rem;">
                    <h5 class="fw-bold text-dark text-center mb-1" style="font-size:1em;">Filtrar áreas</h5>
                    <form class="w-100 d-flex flex-column gap-1" method="get" action="/usuarios" style="margin-bottom:0;">
                        <div class="dropdown w-100">
                            <button class="btn btn-area dropdown-toggle w-100" type="button" id="dropdownArea" data-bs-toggle="dropdown" aria-expanded="false" style="font-size:0.95em; padding:0.3rem 0.1rem;">Área</button>
                            <ul class="dropdown-menu w-100" aria-labelledby="dropdownAreaUsuarios">
                                <li><a class="dropdown-item" href="#">Finanzas y Contabilidad</a></li>
                                <li><a class="dropdown-item" href="#">Recursos Humanos</a></li>
                                <li><a class="dropdown-item" href="#">Tecnologías de la Información</a></li>
                                <li><a class="dropdown-item" href="#">Mercadotecnia</a></li>
                                <li><a class="dropdown-item" href="#">Departamento de Logística</a></li>
                                <li><a class="dropdown-item" href="#">Producción / Operaciones</a></li>
                            </ul>
                        </div>
                        <input class="form-control" type="text" name="nombre" placeholder="Buscar por nombre" aria-label="Nombre..." style="font-size:0.95em;">
                        <button class="btn btn-buscar w-100" type="submit" style="font-size:0.95em; padding:0.3rem 0.7rem;">Buscar</button>
                    </form>
                </div>
                <% } %>
                <% if (title === 'Informes') { %>
                <div class="busqueda-informes mt-2" style="font-size: 0.95em;">
                    <h5 class="fw-bold mb-2 text-dark text-center" style="font-size:1em;">Búsqueda por...</h5>
                    <div class="dropdown mb-1 w-100">
                        <button class="btn btn-area dropdown-toggle w-100" type="button" id="dropdownArea" data-bs-toggle="dropdown" aria-expanded="false" style="font-size:0.95em; padding:0.3rem 0.7rem;">Área</button>
                        <ul class="dropdown-menu w-100" aria-labelledby="dropdownArea">
                            <li><a class="dropdown-item" href="#">Finanzas y Contabilidad</a></li>
                            <li><a class="dropdown-item" href="#">Recursos Humanos (RH)</a></li>
                            <li><a class="dropdown-item" href="#">Tecnologías de la Información (TI)</a></li>
                            <li><a class="dropdown-item" href="#">Mercadotecnia</a></li>
                            <li><a class="dropdown-item" href="#">Departamento de Logística</a></li>
                            <li><a class="dropdown-item" href="#">Producción / Operaciones</a></li>
                        </ul>
                    </div>
                    <button class="btn btn-nuevos mb-1 w-100" style="font-size:0.95em; padding:0.3rem 0.7rem;">Nuevos</button>
                    <div class="dropdown mb-1 w-100">
                        <button class="btn btn-revisados dropdown-toggle w-100" type="button" id="dropdownRevisados" data-bs-toggle="dropdown" aria-expanded="false" style="font-size:0.95em; padding:0.3rem 0.7rem;">Revisados</button>
                        <ul class="dropdown-menu w-100" aria-labelledby="dropdownRevisados">
                            <li><a class="dropdown-item" href="#">Aceptados</a></li>
                            <li><a class="dropdown-item" href="#">Rechazados</a></li>
                        </ul>
                    </div>
                    <div class="d-flex w-100 gap-2 mt-2 justify-content-center">
                        <div class="d-flex flex-column align-items-center">
                            <label for="fecha-desde" class="small mb-1 text-dark text-center label-area" style="font-size:0.95em;"><b>Desde</b></label>
                            <input type="date" id="fecha-desde" class="form-control form-control-sm mb-1 input-area" style="font-size:0.95em;">
                        </div>
                        <div class="d-flex flex-column align-items-center">
                            <label for="fecha-hasta" class="small mb-1 text-dark text-center label-nuevos" style="font-size:0.95em;"><b>Hasta</b></label>
                            <input type="date" id="fecha-hasta" class="form-control form-control-sm mb-1 input-nuevos" style="font-size:0.95em;">
                        </div>
                    </div>
                    <button class="btn btn-buscar w-100 mt-2" type="submit" style="font-size:0.95em; padding:0.3rem 0.7rem;">Buscar</button>
                </div>
                <% } %>
                <% if (title === 'Usuarios') { %>
                <% } %>
            </aside>
            <!-- FIN BARRA LATERAL -->
            <section class="flex-grow-1 d-flex flex-column align-items-center layout-section<% if (title !== 'Inicio') { %> no-bg<% } %>">
                <main class="main-content d-flex flex-column align-items-center w-100">
                    <% if (title === 'Inicio') { %>
                        <div class="bienvenido-box text-center">
                            ¡Bienvenido al sistema! 
                        </div>
                    <% } else { %>
                        <%- body %>
                    <% } %>
                </main>
            </section>
        </div>

        <footer class="footer bg-light text-center py-2" style="width:100%;">
            © 2025 Ayuntamiento de Atlacomulco. Todos los derechos reservados.
        </footer>
    </div>

    <% if (title === 'Informes' || title === 'Usuarios' || title === 'Áreas') { %>
        <div class="fixed-bottom text-end p-4">
            <a href="/" class="btn btn-inicio btn-lg rounded-pill">
                <i class="bi bi-house-door-fill me-2"></i>Inicio
            </a>
        </div>
    <% } %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/sistema.js"></script>
    <script>
        // La función cerrarSesion() viene del archivo /js/sistema.js y se encarga de cerrar modales y redirigir a /inicioSesion
        
        // Función para mostrar toasts (si no existe)
        function mostrarToast(mensaje, tipo = 'info') {
            // Crear toast si no existe el sistema
            console.log(`${tipo.toUpperCase()}: ${mensaje}`);
            
            // Crear un toast simple
            const toast = document.createElement('div');
            toast.className = `alert alert-${tipo === 'danger' ? 'danger' : tipo === 'success' ? 'success' : 'info'} alert-dismissible fade show position-fixed`;
            toast.style.cssText = 'top: 20px; right: 20px; z-index: 9999; min-width: 300px;';
            toast.innerHTML = `
                ${mensaje}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            `;
            document.body.appendChild(toast);
            
            // Auto-remove after 3 seconds
            setTimeout(() => {
                toast.remove();
            }, 3000);
        }
        
        // Función para búsqueda de usuarios
        async function buscarUsuarios() {
            const nombre = document.querySelector('#nombre-filter')?.value || '';
            const area = document.querySelector('#area-filter')?.value || '';
            const rol = document.querySelector('#rol-filter')?.value || '';
            
            const params = new URLSearchParams();
            if (nombre) params.append('nombre', nombre);
            if (area) params.append('area', area);
            if (rol) params.append('rol', rol);
            
            try {
                const response = await fetch(`/api/usuarios/buscar?${params.toString()}`);
                const result = await response.json();
                
                if (result.success) {
                    actualizarTablaUsuarios(result.data.usuarios);
                    mostrarToast(`Se encontraron ${result.data.usuarios.length} usuarios`, 'success');
                } else {
                    mostrarToast('Error en la búsqueda', 'danger');
                }
            } catch (error) {
                console.error('Error:', error);
                mostrarToast('Error al conectar con el servidor', 'danger');
            }
        }
        
        // Función para actualizar tabla de usuarios
        function actualizarTablaUsuarios(usuarios) {
            const tbody = document.querySelector('#usuarios-tbody');
            if (!tbody) return;
            
            tbody.innerHTML = '';
            
            usuarios.forEach((usuario, index) => {
                const row = document.createElement('tr');
                row.dataset.userId = usuario.id;
                row.innerHTML = `
                    <td>${usuario.id}</td>
                    <td>${usuario.nombre}</td>
                    <td>${usuario.apellido}</td>
                    <td>${usuario.area_nombre || 'Sin área asignada'}</td>
                    <td>
                        <div class="d-flex justify-content-center gap-2">
                            <button type="button" class="btn btn-editar btn-sm" data-user-id="${usuario.id}">
                                Editar
                            </button>
                            <button type="button" class="btn btn-danger btn-sm" data-user-id="${usuario.id}">
                                Eliminar
                            </button>
                        </div>
                    </td>
                `;
                tbody.appendChild(row);
            });
        }
        
        // Función para limpiar filtros
        function limpiarFiltros() {
            document.querySelector('#nombre-filter').value = '';
            document.querySelector('#area-filter').value = '';
            document.querySelector('#rol-filter').value = '';
            
            // Recargar tabla con todos los usuarios
            window.location.reload();
        }
    </script>
</body>
</html>

<%- include('ModalConfirm') %>
