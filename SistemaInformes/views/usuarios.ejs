 <div class="text-center mb-4 mt-3">
        <h2 class="titulo-tabla">
            <i class="bi bi-people me-2"></i>Usuarios
        </h2>
    </div>
    <div class="card">
    <div class="card-body p-4">
                <div class="table-scroll">
                <table class="table table-hover text-center data-table">
                        <thead class="text-center">
                            <tr>
                                <th>#</th>
                                <th>Nombre</th>
                                <th>Apellido</th>
                                <th>Área</th>
                                <th>
                                    Acciones
                                    <button id="btn-refrescar-usuarios" class="btn btn-sm btn-outline-secondary btn-icon ms-2" type="button" title="Refrescar lista de usuarios" aria-label="Refrescar lista de usuarios">
                                        <i class="bi bi-arrow-clockwise"></i>
                                    </button>
                                </th>
                            </tr>
                        </thead>
                        <tbody id="usuarios-tbody">
                            <% if (usuarios && usuarios.length > 0) { %>
                                <% usuarios.forEach((usuario, index) => { %>
                                <tr data-user-id="<%= usuario.id %>" data-numero-nomina="<%= usuario.numero_nomina || '' %>" data-is-self="<%= (typeof user !== 'undefined' && user && user.id === usuario.id) ? 'true' : 'false' %>" class="<%= (typeof user !== 'undefined' && user && user.id === usuario.id) ? 'mi-perfil-row' : '' %>">
                                    <td><%= index + 1 %></td>
                                    <td>
                                        <%= usuario.nombre || 'Nombre' %>
                                        <% if (typeof user !== 'undefined' && user && user.id === usuario.id) { %>
                                            <span class="badge bg-info text-dark ms-2 badge-self">Perfil propio</span>
                                        <% } %>
                                    </td>
                                    <td><%= usuario.apellido || 'Apellidos' %></td>
                                    <td><%= usuario.area_nombre || 'Sin área asignada' %></td>
                                    <td>
                                        <div class="d-flex justify-content-center gap-2 nowrap">
                                            <button type="button" 
                                                    class="btn btn-editar btn-sm btn-min-70" 
                                                    data-bs-toggle="modal" 
                                                    data-bs-target="#modalUsuarios"
                                                    data-user-id="<%= usuario.id %>"
                                                    data-username="<%= usuario.username %>"
                                                    data-nombre="<%= usuario.nombre %>"
                                                    data-apellido="<%= usuario.apellido %>"
                                                    data-email="<%= usuario.email %>"
                                                    data-telefono="<%= usuario.telefono || '' %>"
                                                    data-area-id="<%= usuario.area_id || '' %>"
                                                    data-numero-nomina="<%= usuario.numero_nomina || '' %>"
                                                    data-rol-id="<%= usuario.rol_id %>">
                                                Editar
                                            </button>
                                            <button type="button" 
                                                    class="btn btn-danger btn-sm btn-eliminar-usuario btn-min-70"
                                                    data-user-id="<%= usuario.id %>"
                                                    data-user-name="<%= usuario.nombre %> <%= usuario.apellido %>">
                                                Eliminar
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                                <% }); %>
                            <% } else { %>
                                <tr id="no-usuarios">
                                    <td colspan="5" class="text-center text-muted">No hay usuarios registrados</td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            <!-- Botón para añadir nuevo usuario -->
            <div class="w-100 d-flex justify-content-start mt-3">
                <button type="button" 
                        class="btn btn-anadir-usuario" 
                        data-bs-toggle="modal" 
                        data-bs-target="#modalUsuarios">
                    Añadir usuario
                </button>
            </div>
        </div>
    </div>

<%- include('ModalUsuarios') %>
