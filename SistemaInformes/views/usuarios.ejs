
<!-- Vista principal de Usuarios -->
<!-- Encabezado de la sección Usuarios -->
    <div class="text-center mb-4 mt-3">
        <h2 style="color: #a12424; font-weight: bold; margin: 1rem 0;">
            <i class="bi bi-people me-2"></i>Usuarios
        </h2>
    </div>
    <div class="card" style="background: transparent; box-shadow: none; border: none; margin-top: 0;">
    <div class="card-body">
            <div class="table-responsive" style="overflow-x: auto; overflow-y: visible;">
                <table class="table table-hover text-center usuarios-table">
                        <thead class="text-center">
                            <tr>
                                <th>#</th>
                                <th>Nombre</th>
                                <th>Apellido</th>
                                <th>Área</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody id="usuarios-tbody">
                            <% if (usuarios && usuarios.length > 0) { %>
                                <% usuarios.forEach((usuario, index) => { %>
                                <tr data-user-id="<%= usuario.id %>" data-numero-nomina="<%= usuario.numero_nomina || '' %>">
                                    <td><%= usuario.id %></td>
                                    <td><%= usuario.nombre || 'Nombre' %></td>
                                    <td><%= usuario.apellido || 'Apellidos' %></td>
                                    <td><%= usuario.area_nombre || 'Sin área asignada' %></td>
                                    <td>
                                        <div class="d-flex justify-content-center gap-2" style="white-space: nowrap;">
                                            <button type="button" 
                                                    class="btn btn-editar btn-sm" 
                                                    data-bs-toggle="modal" 
                                                    data-bs-target="#modalUsuarios"
                                                    data-user-id="<%= usuario.id %>"
                                                    data-username="<%= usuario.username %>"
                                                    data-nombre="<%= usuario.nombre %>"
                                                    data-apellido="<%= usuario.apellido %>"
                                                    data-email="<%= usuario.email %>"
                                                    data-telefono="<%= usuario.telefono || '' %>"
                                                    data-area-id="<%= usuario.area_id || '' %>"
                                                    data-numero-nomina="<%= usuario.numero_nomina || '' %>"
                                                    data-rol-id="<%= usuario.rol_id %>"
                                                    style="min-width: 70px;">
                                                Editar
                                            </button>
                                            <button type="button" 
                                                    class="btn btn-danger btn-sm btn-eliminar-usuario"
                                                    data-user-id="<%= usuario.id %>"
                                                    data-user-name="<%= usuario.nombre %> <%= usuario.apellido %>"
                                                    style="min-width: 70px;">
                                                Eliminar
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                                <% }); %>
                            <% } else { %>
                                <tr id="no-usuarios">
                                    <td colspan="5" class="text-center text-muted">No hay usuarios registrados</td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
            <!-- Botón para añadir nuevo usuario -->
            <div class="w-100 d-flex justify-content-start mt-3">
                <button type="button" 
                        class="btn btn-anadir-usuario" 
                        data-bs-toggle="modal" 
                        data-bs-target="#modalUsuarios">
                    Añadir usuario
                </button>
            </div>
        </div>
    </div>

<%- include('ModalUsuarios') %>
