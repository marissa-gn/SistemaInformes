<!-- Modal para ver informe -->
<script>
  window.currentUserRole = '<%= user ? user.rol : "" %>';
</script>
<div class="modal fade" id="modalInforme" tabindex="-1" aria-labelledby="modalInformeLabel" aria-hidden="true">
  <div class="modal-dialog modal-xl modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="modalInformeLabel"><b>INFORME</b></h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
      </div>
      <div class="modal-body px-4 py-4">
        <form>
          <!-- Fila 1: Fecha y Área -->
          <div class="row mb-2">
            <div class="col-md-6 mb-2">
              <label for="fechaInforme" class="form-label"><b>Fecha:</b></label>
              <input type="date" class="form-control" id="fechaInforme" readonly>
            </div>
            <div class="col-md-6 mb-2">
              <label for="areaInforme" class="form-label"><b>Área:</b></label>
              <input type="text" class="form-control" id="areaInforme" readonly>
            </div>
          </div>

          <!-- Fila 2: Nombre de Director/Coordinador y Lugar de Actividad -->
          <div class="row mb-2">
            <div class="col-md-6 mb-2">
              <label for="nombreDirector" class="form-label"><b>Nombre de Director / Coordinador / Jefe de Área:</b></label>
              <input type="text" class="form-control" id="nombreDirector" readonly>
            </div>
            <div class="col-md-6 mb-2">
              <label for="lugarActividad" class="form-label"><b>Lugar de Actividad:</b></label>
              <input type="text" class="form-control" id="lugarActividad" readonly>
            </div>
          </div>

          <!-- Fila 3: Colonia/Comunidad y Tipo de Actividad -->
          <div class="row mb-2">
            <div class="col-md-6 mb-2">
              <label for="coloniaComunidad" class="form-label"><b>Colonia o Comunidad:</b></label>
              <input type="text" class="form-control" id="coloniaComunidad" readonly>
            </div>
            <div class="col-md-6 mb-2">
              <label for="tipoActividad" class="form-label"><b>Tipo de Actividad / Unidad de Medida:</b></label>
              <input type="text" class="form-control" id="tipoActividad" readonly>
            </div>
          </div>

          <!-- Fila 4: Cantidad y Sector que beneficia -->
          <div class="row mb-2">
            <div class="col-md-6 mb-2">
              <label for="cantidad" class="form-label"><b>Cantidad:</b></label>
              <input type="text" class="form-control" id="cantidad" readonly>
            </div>
            <div class="col-md-6 mb-2">
              <label for="sectorBeneficia" class="form-label"><b>Sector al que Beneficia:</b></label>
              <input type="text" class="form-control" id="sectorBeneficia" readonly>
            </div>
          </div>

          <!-- Descripción de la Actividad -->
          <div class="mb-2">
            <label for="descripcionActividad" class="form-label"><b>Descripción de la Actividad:</b></label>
            <textarea class="form-control" id="descripcionActividad" readonly style="min-height: 80px;"></textarea>
          </div>

          <!-- Fila 5: Número de Beneficiarios y Monto Generado -->
          <div class="row mb-2">
            <div class="col-md-6 mb-2">
              <label for="numeroBeneficiarios" class="form-label"><b>Número de Beneficiarios:</b></label>
              <input type="text" class="form-control" id="numeroBeneficiarios" readonly>
            </div>
            <div class="col-md-6 mb-2">
              <label for="montoGenerado" class="form-label"><b>Monto Generado (si aplica):</b></label>
              <input type="text" class="form-control" id="montoGenerado" readonly>
            </div>
          </div>

          <!-- Fila 6: Dos preguntas de sí/no -->
          <div class="row mb-2">
            <div class="col-md-6 mb-2">
              <label for="perteneceArea" class="form-label"><b>¿Pertenece la actividad a los procedimientos de su área?</b></label>
              <input type="text" class="form-control" id="perteneceArea" readonly>
            </div>
            <div class="col-md-6 mb-2">
              <label for="respondeClientela" class="form-label"><b>¿La actividad responde a una solicitud de la ciudadanía?</b></label>
              <input type="text" class="form-control" id="respondeClientela" readonly>
            </div>
          </div>

          <!-- Evidencia Fotográfica -->
          <div class="mb-2">
            <label class="form-label"><b>Evidencia Fotográfica:</b></label>
            <div id="contenedorEvidencia" class="border rounded p-3" style="background-color: #f8f9fa; min-height: 150px; display: flex; align-items: center; justify-content: center;">
              <div id="galeriaEvidencia" class="w-100">
                <!-- Las imágenes se cargarán aquí dinámicamente -->
              </div>
              <div id="sinEvidencia" class="text-muted text-center">
                No hay evidencia fotográfica
              </div>
            </div>
          </div>

          <!-- Observaciones -->
          <div class="mb-2">
            <label for="observaciones" class="form-label"><b>Observaciones:</b></label>
            <textarea class="form-control" id="observaciones" readonly style="min-height: 60px;"></textarea>
          </div>

          <!-- Evaluación del Admin (solo visible si está evaluado) -->
          <div class="mb-2" id="evaluacionAdmin" style="display: none; border-top: 2px solid #a12424; padding-top: 15px; margin-top: 15px;">
            <div class="row mb-2">
              <div class="col-md-12 mb-2">
                <label for="estadoEvaluacion" class="form-label"><b>Estado de Evaluación:</b></label>
                <input type="text" class="form-control" id="estadoEvaluacion" readonly style="color: #28a745; font-weight: bold;">
              </div>
            </div>
            <div class="mb-2">
              <label for="comentariosRevision" class="form-label"><b>Comentarios:</b></label>
              <textarea class="form-control" id="comentariosRevision" readonly style="min-height: 80px;"></textarea>
            </div>
          </div>
        </form>
      </div>
      <div class="modal-footer">
        <!-- Botones para evaluar informe (solo visible si estado es 'enviado') -->
        <div id="botonesEvaluacion" style="display: none; width: 100%; margin-right: auto;">
          <textarea id="comentariosEvaluacion" class="form-control form-control-sm mb-2" placeholder="Comentarios de la evaluación..." rows="2" style="max-width: 400px;"></textarea>
          <button type="button" class="btn btn-success btn-sm" id="btnAceptar" onclick="evaluarInforme('aceptar')">
            <i class="bi bi-check-circle"></i> Aceptar
          </button>
          <button type="button" class="btn btn-danger btn-sm" id="btnRechazar" onclick="evaluarInforme('rechazar')">
            <i class="bi bi-x-circle"></i> Rechazar
          </button>
        </div>
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
      </div>
    </div>
  </div>
</div>
