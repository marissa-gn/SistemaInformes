<!-- Modal para ver informe -->
<div class="modal fade" id="modalInforme" tabindex="-1" aria-labelledby="modalInformeLabel" aria-hidden="true">
  <div class="modal-dialog modal-xl modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="modalInformeLabel"><b>INFORME</b></h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
      </div>
      <div class="modal-body px-4 py-4">
        <form>
          <!-- Fila 0: Nombre de quien envía y Fecha -->
          <div class="row mb-2">
            <div class="col-md-6 mb-2">
              <label for="nombreRemitente" class="form-label"><b>Nombre de quien envía:</b></label>
              <input type="text" class="form-control" id="nombreRemitente">
            </div>
            <div class="col-md-6 mb-2">
              <label for="fechaEnvio" class="form-label"><b>Fecha:</b></label>
              <input type="date" class="form-control" id="fechaEnvio">
            </div>
          </div>
          <!-- Fila 1: Área y Sector -->
          <div class="row mb-2">
            <div class="col-md-6 mb-2">
              <label for="area" class="form-label"><b>Área:</b></label>
              <input type="text" class="form-control" id="area">
            </div>
            <div class="col-md-6 mb-2">
              <label for="sector" class="form-label"><b>Sector al que beneficia:</b></label>
              <input type="text" class="form-control" id="sector">
            </div>
          </div>
          <!-- Fila 2: Colonia y Lugar de actividad -->
          <div class="row mb-2">
            <div class="col-md-6 mb-2">
              <label for="colonia" class="form-label"><b>Colonia o comunidad:</b></label>
              <input type="text" class="form-control" id="colonia">
            </div>
            <div class="col-md-6 mb-2">
              <label for="lugar" class="form-label"><b>Lugar de actividad:</b></label>
              <input type="text" class="form-control" id="lugar">
            </div>
          </div>
          <!-- Fila 3: Tipo de actividad y Número de beneficiarios -->
          <div class="row mb-2">
            <div class="col-md-6 mb-2">
              <label for="tipo" class="form-label"><b>Tipo de actividad / unidad de medida:</b></label>
              <input type="text" class="form-control" id="tipo">
            </div>
            <div class="col-md-6 mb-2">
              <label for="beneficiarios" class="form-label"><b>Número de beneficiarios:</b></label>
              <input type="text" class="form-control" id="beneficiarios">
            </div>
          </div>
          <!-- Fila 4: Monto generado y Monto invertido -->
          <div class="row mb-2">
            <div class="col-md-6 mb-2">
              <label for="monto" class="form-label"><b>Monto generado por la actividad (si aplica):</b></label>
              <input type="text" class="form-control" id="monto">
            </div>
            <div class="col-md-6 mb-2">
              <label for="montoInvertido" class="form-label"><b>¿Cuál fue el monto invertido en la actividad?</b></label>
              <div class="input-group">
                <span class="input-group-text">$</span>
                <input type="text" class="form-control" id="montoInvertido">
              </div>
            </div>
          </div>
          <!-- Fila 5: Evidencia fotográfica y Solicitud/procedimientos -->
          <div class="row mb-2">
            <div class="col-md-6 mb-2">
              <label for="evidencia" class="form-label"><b>Evidencia fotográfica:</b></label>
              <input class="form-control" type="file" id="evidencia" accept="image/*">
            </div>
            <div class="col-md-3 mb-2 text-center d-flex flex-column align-items-center justify-content-center">
              <label for="solicitudCiudadania" class="form-label w-100 text-center" style="white-space: normal;"><b>¿Responde a una solicitud de la ciudadanía?</b></label>
              <select class="form-select text-center" id="solicitudCiudadania" style="max-width: 90%; margin: 0 auto;">
                <option value="" class="text-center">Selecciona...</option>
                <option value="si">Sí</option>
                <option value="no">No</option>
              </select>
            </div>
            <div class="col-md-3 mb-2 text-center d-flex flex-column align-items-center justify-content-center">
              <label for="procedimientosArea" class="form-label w-100 text-center" style="white-space: normal;"><b>¿Pertenece la actividad a los procedimientos de su área?</b></label>
              <select class="form-select text-center" id="procedimientosArea" style="max-width: 90%; margin: 0 auto;">
                <option value="" class="text-center">Selecciona...</option>
                <option value="si">Sí</option>
                <option value="no">No</option>
              </select>
            </div>
          </div>
          <div class="mb-2">
            <label for="descripcion" class="form-label"><b>Descripción de la actividad:</b></label>
            <input type="text" class="form-control" id="descripcion">
          </div>
          <div class="mb-2">
            <label for="observaciones" class="form-label"><b>Observaciones:</b></label>
            <input type="text" class="form-control" id="observaciones">
          </div>
          <div class="mb-2 text-center">
            <label for="comentarios" class="form-label" style="color: #a12424; width: 100%; display: block;"><b>Comentarios sobre el informe:</b></label>
            <input type="text" class="form-control text-center" id="comentarios" style="color: #a12424; font-weight: bold;">
          </div>
          <div class="mb-2 d-flex gap-2 align-items-center">
            <div class="form-check">
              <input class="form-check-input" type="radio" name="evaluacion" id="rechazar">
              <label class="form-check-label" for="rechazar"><b>Rechazar</b></label>
            </div>
            <div class="form-check">
              <input class="form-check-input" type="radio" name="evaluacion" id="aceptar">
              <label class="form-check-label" for="aceptar"><b>Aprobar</b></label>
            </div>
          </div>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-success" id="btnAceptarInforme" data-bs-dismiss="modal" onclick="mostrarInformeRevisado()">Aceptar</button>
        <button type="button" class="btn btn-danger" data-bs-dismiss="modal" onclick="mostrarCambiosCancelados()">Cancelar</button>
      </div>
    </div>
  </div>
</div>
