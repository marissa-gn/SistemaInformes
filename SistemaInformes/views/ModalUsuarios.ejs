<div class="modal fade" id="modalUsuarios" tabindex="-1" aria-labelledby="modalUsuariosLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content usuario-modal-shell">
      <div class="modal-header">
        <div class="d-flex flex-column">
          <h5 class="modal-title mb-0" id="modal-titulo"><b>Crear Usuario</b></h5>
          <small class="usuario-modal-subtitle">Captura y edición con validaciones de nombre, apellidos, teléfono y contraseña.</small>
        </div>
        <div id="modal-badge-self" style="display:none; margin-left:12px;">
            <span class="badge bg-info text-dark">Perfil propio</span>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
      </div>
      <div class="modal-body px-4 py-4 usuario-modal-body" style="max-height: 75vh; overflow-y: auto; overflow-x: hidden;">
        <form id="form-usuario" novalidate>
          <input type="hidden" id="usuario-id" name="usuario_id" value="">
          
          <!-- Campos principales del usuario -->
          <div class="usuario-form-section">
            <div class="usuario-form-section-title">Identidad</div>
            <div class="row mb-3">
            <div class="col-md-6 mb-2">
              <label for="username" class="form-label">Usuario:</label>
              <input type="text" class="form-control" id="username" name="username" required>
              <div class="invalid-feedback">El usuario es requerido.</div>
            </div>
            <div class="col-md-6 mb-2">
              <label for="numero_nomina" class="form-label">Número de Nómina:</label>
              <input type="text" class="form-control" id="numero_nomina" name="numero_nomina" placeholder="Número de nómina" required>
              <div class="invalid-feedback">El número de nómina es requerido.</div>
            </div>
          </div>
          <div class="row mb-3">
            <div class="col-md-6 mb-2">
              <label for="nombre" class="form-label">Nombre:</label>
              <input type="text" class="form-control" id="nombre" name="nombre" required maxlength="100" pattern="[A-Za-zÁÉÍÓÚÜÑáéíóúüñ\s'\-]+">
              <div class="invalid-feedback">El nombre es requerido.</div>
            </div>
            <div class="col-md-6 mb-2">
              <label for="apellido_paterno" class="form-label">Apellido paterno:</label>
              <input type="text" class="form-control" id="apellido_paterno" name="apellido_paterno" required maxlength="100" pattern="[A-Za-zÁÉÍÓÚÜÑáéíóúüñ\s'\-]+">
              <div class="invalid-feedback">El apellido paterno es requerido.</div>
            </div>
          </div>
          <div class="row mb-3">
            <div class="col-md-6 mb-2">
              <label for="apellido_materno" class="form-label">Apellido materno:</label>
              <input type="text" class="form-control" id="apellido_materno" name="apellido_materno" required maxlength="100" pattern="[A-Za-zÁÉÍÓÚÜÑáéíóúüñ\s'\-]+">
              <div class="invalid-feedback">El apellido materno es requerido.</div>
            </div>
            <div class="col-md-6 mb-2">
              <label for="telefono" class="form-label">Teléfono:</label>
              <input type="tel" class="form-control" id="telefono" name="telefono" maxlength="10" inputmode="numeric" pattern="[0-9]{10}" placeholder="10 dígitos">
              <div class="invalid-feedback">El teléfono debe tener exactamente 10 dígitos numéricos.</div>
            </div>
          </div>
          </div>

          <div class="usuario-form-section">
            <div class="usuario-form-section-title">Contacto y acceso</div>
            <div class="row mb-3">
            <div class="col-md-6 mb-2">
              <label for="email" class="form-label">Correo electrónico:</label>
              <input type="email" class="form-control" id="email" name="email" required 
                     placeholder="ejemplo@correo.com">
              <div class="invalid-feedback">El correo electrónico es requerido y debe ser válido.</div>
            </div>
            <div class="col-md-6 mb-2">
              <label for="area_id" class="form-label">Área:</label>
              <select class="form-select" id="area_id" name="area_id">
                <option value="">Selecciona...</option>
                <% if (typeof areas !== 'undefined' && areas && areas.length > 0) { %>
                  <% areas.forEach(area => { %>
                    <option value="<%= area.id %>"><%= area.nombre %></option>
                  <% }); %>
                <% } else { %>
                  <option value="1">Departamento de Tecnologías de la Información</option>
                  <option value="2">Finanzas y Contabilidad</option>
                  <option value="3">Recursos Humanos</option>
                  <option value="4">Mercadotecnia</option>
                  <option value="5">Departamento de Logística</option>
                <% } %>
              </select>
            </div>
          </div>
          <div class="row mb-3">
            <div class="col-md-6 mb-2">
              <label for="rol_id" class="form-label">Rol de usuario:</label>
              <select class="form-select" id="rol_id" name="rol_id" required>
                <option value="">Selecciona...</option>
                <option value="1">Administrador</option>
                <option value="2">Capturista</option>
                <option value="3">Visitante</option>
              </select>
              <div class="invalid-feedback">El rol es requerido.</div>
              <div id="self-role-note" class="form-text" style="display:none; margin-top:6px;">No puedes cambiar tu propio rol desde aquí.</div>
            </div>
          </div>
          </div>

          <!-- Contraseña al final -->
          <div class="usuario-form-section usuario-password-section">
            <div class="usuario-form-section-title">Seguridad</div>
            <div class="row mb-6">
            <div class="col-md-6 mb-3">
              <label for="password" class="form-label">Contraseña:</label>
              <div class="input-group">
                <input type="password" class="form-control" id="password" name="password" minlength="6" maxlength="10">
                <button type="button" class="btn btn-outline-secondary" data-toggle-password="password" aria-label="Mostrar contraseña">
                  <i class="bi bi-eye"></i>
                </button>
              </div>
              <div class="form-text" id="password-help"> Dejar en blanco para mantener contraseña actual (al editar).</div>
            </div>
            <div class="col-md-4 mb-6" id="confirm-password-row">
              <label for="confirm-password" class="form-label">Confirmar Contraseña:</label>
              <div class="input-group">
                <input type="password" class="form-control" id="confirm-password" name="confirm_password" minlength="6" maxlength="10">
                <button type="button" class="btn btn-outline-secondary" data-toggle-password="confirm-password" aria-label="Mostrar confirmación de contraseña">
                  <i class="bi bi-eye"></i>
                </button>
              </div>
              <div class="invalid-feedback">Las contraseñas no coinciden.</div>
            </div>
          </div>
          </div>
        </form>
      </div>
      <div class="modal-footer usuario-modal-footer">
        <button type="button" class="btn btn-success" id="btn-guardar-usuario">Guardar</button>
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
      </div>
    </div>
  </div>
</div>
<!-- Note: modal styles are provided globally in public/styles.css -->