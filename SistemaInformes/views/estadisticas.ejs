<!-- Contenedor específico para estadísticas -->
<div class="estadisticas-page">
  <div class="estadisticas-hero text-center mb-3">
    <div class="estadisticas-hero-kicker">Panel de análisis</div>
    <h2 class="estadisticas-hero-title mb-2"><i class="bi bi-bar-chart me-2"></i>Estadísticas de Informes</h2>
    <p class="estadisticas-hero-copy mb-0">Resumen visual de beneficiarios, montos, áreas, sectores, colonias, evidencias y flujo temporal.</p>
  </div>

  <div class="estadisticas-summary-card card shadow-sm mx-auto mb-4">
    <div class="card-body d-flex flex-column flex-md-row align-items-center justify-content-between gap-3 py-4">
      <div>
  </div>

  <!-- Contenedor con scroll para las gráficas -->
  <div class="estadisticas-scroll-container">
    <div class="container estadisticas-grid-shell">
      <div class="row mb-4">
        <div class="col-md-6 mb-4"><div class="card estadistica-card h-100"><div class="card-header text-center">Beneficiarios</div><div class="card-body d-flex justify-content-center align-items-center"><canvas id="graficaBeneficiarios" width="300" height="200" style="max-width:100%;max-height:220px;"></canvas></div></div></div>
        <div class="col-md-6 mb-4"><div class="card estadistica-card h-100"><div class="card-header text-center">Montos</div><div class="card-body d-flex justify-content-center align-items-center"><canvas id="graficaMontos" width="300" height="200" style="max-width:100%;max-height:220px;"></canvas></div></div></div>
      </div>
      <div class="row mb-4">
        <div class="col-md-6 mb-4"><div class="card estadistica-card h-100"><div class="card-header text-center">Áreas</div><div class="card-body d-flex justify-content-center align-items-center"><canvas id="graficaAreas" width="300" height="200" style="max-width:100%;max-height:220px;"></canvas></div></div></div>
        <div class="col-md-6 mb-4"><div class="card estadistica-card h-100"><div class="card-header text-center">Sectores</div><div class="card-body d-flex justify-content-center align-items-center"><canvas id="graficaSectores" width="300" height="200" style="max-width:100%;max-height:220px;"></canvas></div></div></div>
      </div>
      <div class="row mb-4">
        <div class="col-md-6 mb-4"><div class="card estadistica-card h-100"><div class="card-header text-center">Colonias</div><div class="card-body d-flex justify-content-center align-items-center"><canvas id="graficaColonia" width="300" height="200" style="max-width:100%;max-height:220px;"></canvas></div></div></div>
        <div class="col-md-6 mb-4"><div class="card estadistica-card h-100"><div class="card-header text-center">Lugares</div><div class="card-body d-flex justify-content-center align-items-center"><canvas id="graficaLugar" width="300" height="200" style="max-width:100%;max-height:220px;"></canvas></div></div></div>
      </div>
      <div class="row mb-4">
        <div class="col-md-6 mb-4"><div class="card estadistica-card h-100"><div class="card-header text-center">Tipo de actividad</div><div class="card-body d-flex justify-content-center align-items-center"><canvas id="graficaTipoActividad" width="300" height="200" style="max-width:100%;max-height:220px;"></canvas></div></div></div>
        <div class="col-md-6 mb-4"><div class="card estadistica-card h-100"><div class="card-header text-center">Evidencia</div><div class="card-body d-flex justify-content-center align-items-center"><canvas id="graficaEvidencia" width="300" height="200" style="max-width:100%;max-height:220px;"></canvas></div></div></div>
      </div>
      <div class="row mb-4">
        <div class="col-md-6 mb-4"><div class="card estadistica-card h-100"><div class="card-header text-center">Solicitudes</div><div class="card-body d-flex justify-content-center align-items-center"><canvas id="graficaSolicitudes" width="300" height="200" style="max-width:100%;max-height:220px;"></canvas></div></div></div>
        <div class="col-md-6 mb-4"><div class="card estadistica-card h-100"><div class="card-header text-center">Procedimientos</div><div class="card-body d-flex justify-content-center align-items-center"><canvas id="graficaProcedimientos" width="300" height="200" style="max-width:100%;max-height:220px;"></canvas></div></div></div>
      </div>
      <div class="row mb-4">
        <div class="col-md-12 mb-4"><div class="card estadistica-card h-100"><div class="card-header text-center">Fechas</div><div class="card-body d-flex justify-content-center align-items-center"><canvas id="graficaFecha" width="300" height="200" style="max-width:100%;max-height:220px;"></canvas></div></div></div>
      </div>
      <div class="row mb-4">
        <div class="col-md-12 mb-4"><div class="card estadistica-card h-100"><div class="card-header text-center">Cantidad temporal</div><div class="card-body d-flex justify-content-center align-items-center"><canvas id="graficaCantidadTemporal" width="300" height="150" style="max-width:100%;max-height:200px;"></canvas></div></div></div>
      </div>
      <div class="row mb-4">
        <div class="col-md-12 mb-4"><div class="card estadistica-card h-100"><div class="card-header text-center">Beneficiarios temporales</div><div class="card-body d-flex justify-content-center align-items-center"><canvas id="graficaBeneficiariosTemporal" width="300" height="150" style="max-width:100%;max-height:200px;"></canvas></div></div></div>
      </div>
      <div class="row mb-4">
        <div class="col-md-12 mb-4"><div class="card estadistica-card h-100"><div class="card-header text-center">Montos temporales</div><div class="card-body d-flex justify-content-center align-items-center"><canvas id="graficaMontosTemporalChart" width="300" height="150" style="max-width:100%;max-height:200px;"></canvas></div></div></div>
      </div>
      <div class="row mb-4">
        <div class="col-md-12 mb-4"><div class="card estadistica-card h-100"><div class="card-header text-center">Capturistas</div><div class="card-body d-flex justify-content-center align-items-center"><canvas id="graficaUsuarios" width="300" height="150" style="max-width:100%;max-height:250px;"></canvas></div></div></div>
      </div>
    </div>
  </div>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script src="/js/estadisticas.js"></script>
  <!-- Fin del contenedor con scroll -->
</div>
<!-- Fin del contenedor de estadísticas -->

<!-- Botón de inicio -->
<div class="btn-inicio-flotante">
  <a href="/informes" class="btn btn-inicio btn-lg rounded-pill">
    <i class="bi bi-house-door-fill me-2"></i>Inicio
  </a>
</div>
