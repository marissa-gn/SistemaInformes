<% 
// Determine display name (prefer `user`, fallback to `session.user`), show only first name
const _rawName = (typeof user !== 'undefined' && user && user.nombre) ? user.nombre : ((typeof session !== 'undefined' && session && session.user && session.user.nombre) ? session.user.nombre : '');
const firstName = _rawName ? String(_rawName).split(' ')[0] : '';
%>
<aside class="sidebar-logo d-flex flex-column align-items-center justify-content-between">
    <div class="w-100 d-flex flex-column align-items-center">
    <%- include('./userBadge') %>
        <img src="/Img/logo.jpg" class="logo img-fluid mx-auto d-block mb-2" alt="Logo Atlacomulco">

        <% if (title === 'Usuarios') { %>
            <div class="busqueda-usuarios d-flex flex-column align-items-center gap-1 w-100 mt-2">
                <h5 class="fw-bold text-dark text-center mb-1" style="font-size:1em;">Filtrar usuarios</h5>
                <div class="w-100 d-flex flex-column gap-1 mb-0">
                    <select class="form-select form-select-sm" id="area-filter">
                            <option value="">Todas las áreas</option>
                            <% if (typeof areas !== 'undefined' && areas && areas.length > 0) { %>
                                <% areas.forEach(a => { %>
                                    <option value="<%= a.id %>"><%= a.nombre %></option>
                                <% }) %>
                            <% } %>
                    </select>
                    <select class="form-select form-select-sm" id="rol-filter">
                            <option value="">Todos los roles</option>
                            <% if (typeof roles !== 'undefined' && roles && roles.length > 0) { %>
                                <% roles.forEach(r => { %>
                                    <option value="<%= r.id %>"><%= r.nombre %></option>
                                <% }) %>
                            <% } %>
                    </select>
                    <input class="form-control form-control-sm" type="text" id="nombre-filter" placeholder="Buscar por nombre" />
                    <button class="btn btn-buscar btn-sm w-100" type="button" data-action="buscar-usuarios"><i class="bi bi-search"></i> Buscar</button>
                    <button class="btn btn-secondary btn-sm w-100" type="button" data-action="limpiar-filtros"><i class="bi bi-arrow-clockwise"></i> Limpiar</button>
                </div>
            </div>
        <% } %>

        <% if (title === 'Áreas') { %>
            <div class="busqueda-usuarios d-flex flex-column align-items-center gap-1 w-100 mt-2">
                <h5 class="fw-bold text-dark text-center mb-1" style="font-size:1em;">Filtrar áreas</h5>
                <div class="w-100 d-flex flex-column gap-1 mb-0">
                    <select class="form-select form-select-sm" id="area-select-filter">
                        <option value="">Todas las áreas</option>
                        <% if (typeof areas !== 'undefined' && areas && areas.length > 0) { %>
                            <% areas.forEach(a => { %>
                                <option value="<%= a.id %>"><%= a.nombre %></option>
                            <% }) %>
                        <% } %>
                    </select>
                    <input class="form-control form-control-sm" type="text" id="nombre-area-filter" placeholder="Buscar por nombre" />
                    <button class="btn btn-buscar btn-sm w-100" type="button" data-action="buscar-areas"><i class="bi bi-search"></i> Buscar</button>
                    <button class="btn btn-secondary btn-sm w-100" type="button" data-action="limpiar-filtros-areas"><i class="bi bi-arrow-clockwise"></i> Limpiar</button>
                </div>
            </div>
        <% } %>

        <% if (title === 'Informes' || title === 'Ver Informes') { %>
            <div class="busqueda-usuarios d-flex flex-column align-items-center gap-1 w-100 mt-2">
                <h5 class="fw-bold text-dark text-center mb-1" style="font-size:1em;">Filtrar informes</h5>
                <div class="w-100 d-flex flex-column gap-1 mb-0">
                    <select class="form-select form-select-sm" id="area-filter-informes">
                        <option value="">Todas las áreas</option>
                        <% if (typeof areas !== 'undefined' && areas && areas.length > 0) { %>
                            <% areas.forEach(a => { %>
                                <option value="<%= a.id %>"><%= a.nombre %></option>
                            <% }) %>
                        <% } %>
                    </select>
                    <label for="fecha-desde-informes" class="small mb-1 text-dark"><b>Desde</b></label>
                    <input type="date" id="fecha-desde-informes" class="form-control form-control-sm mb-1" />
                    <label for="fecha-hasta-informes" class="small mb-1 text-dark"><b>Hasta</b></label>
                    <input type="date" id="fecha-hasta-informes" class="form-control form-control-sm mb-1" />
                    <button class="btn btn-buscar btn-sm w-100" type="button" data-action="buscar-informes"><i class="bi bi-search"></i> Buscar</button>
                    <button class="btn btn-secondary btn-sm w-100" type="button" data-action="limpiar-filtros-informes"><i class="bi bi-arrow-clockwise"></i> Limpiar</button>
                </div>
            </div>
        <% } %>

        <% if (title === 'Historial de Informes') { %>
            <div class="busqueda-informes mt-2 w-100">
                <h5 class="fw-bold mb-2 text-dark text-center">Búsqueda por...</h5>
                <div class="w-100 mb-2">
                    <button class="btn btn-buscar w-100" type="button" data-action="buscar-historial">Buscar</button>
                </div>
            </div>
        <% } %>
    </div>
</aside>
