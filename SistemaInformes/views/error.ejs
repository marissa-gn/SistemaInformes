<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title || 'Error' %></title>
  <link rel="stylesheet" href="/styles.css">
  <style>body{font-family:Arial,Helvetica,sans-serif;padding:40px;background:#fff;color:#333} .card{max-width:800px;margin:0 auto;padding:20px;border:1px solid #ddd;border-radius:6px} h1{color:#a00}</style>
</head>
<body>
  <div class="card">
    <h1><%= title || 'Error' %></h1>
    <p><%= message || 'Ocurrió un error al procesar la solicitud.' %></p>
    <% if (error && error.status) { %>
      <p><strong>Código:</strong> <%= error.status %></p>
    <% } %>
    <p><a href="/inicioSesion">Volver al inicio de sesión</a></p>
  </div>
</body>
</html>
