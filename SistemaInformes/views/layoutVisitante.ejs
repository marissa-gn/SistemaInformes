<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title || 'Sistema de Informes' %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/styles.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
</head>
<body>
    <div>
        <!-- Menú principal superior - Solo opciones permitidas para visitantes -->
        <nav class="navbar navbar-expand-lg navbar-main px-3 py-0">
            <div class="container-fluid flex-nowrap">
                <span class="navbar-brand">Ayuntamiento de Atlacomulco</span>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainMenu" aria-controls="mainMenu" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainMenu">
                    <ul class="navbar-nav ms-auto mb-2 mb-lg-0 d-flex flex-row align-items-center gap-2">
                        <!-- Solo opciones de lectura para visitantes: Ver Informes y Estadísticas -->
                        <li class="nav-item"><a class="nav-link fw-bold" href="/ver-informes">Ver Informes</a></li>
                        <li class="nav-item"><a class="nav-link fw-bold" href="/estadisticas-visitante">Estadísticas</a></li>
                    </ul>
                    <button class="btn btn-danger btn-logout ms-lg-3" type="button" onclick="cerrarSesion()"><i class="bi bi-x-circle"></i> Cerrar sesión</button>
                </div>
            </div>
        </nav>

        <div class="layout-row">
            <!-- Barra lateral -->
            <aside class="sidebar-logo d-flex flex-column align-items-center justify-content-between">
                <div class="w-100 d-flex flex-column align-items-center">
                    <div class="d-flex flex-row align-items-center justify-content-center mb-2" style="gap: 0.5rem;">
                        <svg xmlns="http://www.w3.org/2000/svg" width="15px" height="15px" fill="#624700" class="bi bi-person-circle" viewBox="0 0 16 16" style="margin-bottom:0;">
                            <path d="M11 6a3 3 0 1 1-6 0 3 3 0 0 1 6 0"/>
                            <path fill-rule="evenodd" d="M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8m8-7a7 7 0 0 0-5.468 11.37C3.242 11.226 4.805 10 8 10s4.757 1.225 5.468 2.37A7 7 0 0 0 8 1"/>
                        </svg>
                        <span class="user-name" style="font-size: 1em; color: #624700; font-weight: 600; margin-bottom:0;"><%= session.user?.nombre || 'Visitante' %> <%= session.user?.apellido || '' %></span>
                    </div>
                    <img src="/Img/logo.jpg" class="logo img-fluid mx-auto d-block mb-2" alt="Logo Atlacomulco">
                    
                    <% if (title === 'Ver Informes') { %>
                        <!-- Filtro de informes para visitantes -->
                        <div class="busqueda-informes mt-2" style="font-size: 0.95em;">
                            <h5 class="fw-bold mb-2 text-dark text-center" style="font-size:1em;">Búsqueda por...</h5>
                            <div class="dropdown mb-1 w-100">
                                <button class="btn btn-area dropdown-toggle w-100" type="button" id="dropdownPeriodo" data-bs-toggle="dropdown" aria-expanded="false" style="font-size:0.95em; padding:0.3rem 0.7rem;">Período</button>
                                <ul class="dropdown-menu w-100" aria-labelledby="dropdownPeriodo">
                                    <li><a class="dropdown-item" href="#">Enero 2025</a></li>
                                    <li><a class="dropdown-item" href="#">Febrero 2025</a></li>
                                    <li><a class="dropdown-item" href="#">Marzo 2025</a></li>
                                    <li><a class="dropdown-item" href="#">Q1 2025</a></li>
                                    <li><a class="dropdown-item" href="#">2024</a></li>
                                    <li><a class="dropdown-item" href="#">Diciembre 2024</a></li>
                                </ul>
                            </div>
                            <div class="dropdown mb-1 w-100">
                                <button class="btn btn-area dropdown-toggle w-100" type="button" id="dropdownArea" data-bs-toggle="dropdown" aria-expanded="false" style="font-size:0.95em; padding:0.3rem 0.7rem;">Área</button>
                                <ul class="dropdown-menu w-100" aria-labelledby="dropdownArea">
                                    <li><a class="dropdown-item" href="#">Finanzas y Contabilidad</a></li>
                                    <li><a class="dropdown-item" href="#">Recursos Humanos (RH)</a></li>
                                    <li><a class="dropdown-item" href="#">Tecnologías de la Información (TI)</a></li>
                                    <li><a class="dropdown-item" href="#">Mercadotecnia</a></li>
                                    <li><a class="dropdown-item" href="#">Departamento de Logística</a></li>
                                    <li><a class="dropdown-item" href="#">Producción / Operaciones</a></li>
                                </ul>
                            </div>
                            <div class="dropdown mb-1 w-100">
                                <button class="btn btn-nuevos dropdown-toggle w-100" type="button" id="dropdownEstado" data-bs-toggle="dropdown" aria-expanded="false" style="font-size:0.95em; padding:0.3rem 0.7rem;">Estado</button>
                                <ul class="dropdown-menu w-100" aria-labelledby="dropdownEstado">
                                    <li><a class="dropdown-item" href="#">Completado</a></li>
                                    <li><a class="dropdown-item" href="#">En Proceso</a></li>
                                    <li><a class="dropdown-item" href="#">Cancelado</a></li>
                                </ul>
                            </div>
                            <div class="d-flex w-100 gap-2 mt-2 justify-content-center">
                                <div class="d-flex flex-column align-items-center">
                                    <label for="fecha-desde" class="small mb-1 text-dark text-center label-area" style="font-size:0.95em;"><b>Desde</b></label>
                                    <input type="date" id="fecha-desde" class="form-control form-control-sm mb-1 input-area" style="font-size:0.95em;">
                                </div>
                                <div class="d-flex flex-column align-items-center">
                                    <label for="fecha-hasta" class="small mb-1 text-dark text-center label-nuevos" style="font-size:0.95em;"><b>Hasta</b></label>
                                    <input type="date" id="fecha-hasta" class="form-control form-control-sm mb-1 input-nuevos" style="font-size:0.95em;">
                                </div>
                            </div>
                            <button class="btn btn-buscar w-100 mt-2" type="button" onclick="buscarInformes()" style="font-size:0.95em; padding:0.3rem 0.7rem;">Buscar</button>
                        </div>
                    <% } %>
                </div>
            </aside>
            <!-- Fin barra lateral -->
            <section class="layout-section<% if (title !== 'Inicio - Visitante') { %> no-bg<% } %>">
                <% if (title === 'Inicio - Visitante') { %>
                    <main class="main-content inicio-bg d-flex align-items-center justify-content-center position-relative" style="min-height: 100%; width: 100%;">
                        <div class="bienvenido-box text-center" style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); white-space: normal;">
                            ¡Bienvenido al sistema!
                        </div>
                    </main>
                <% } else { %>
                    <% if (title === 'Ver Informes') { %>
                        <!-- Botón para mostrar filtros en móvil -->
                        <button class="btn btn-primary mobile-filter-toggle d-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#mobileFilters">
                            <i class="bi bi-funnel me-1"></i>Filtros
                        </button>
                    <% } %>
                    <main class="main-content">
                        <%- body %>
                    </main>
                <% } %>
            </section>
        </div>

        <!-- Offcanvas para filtros móviles -->
        <% if (title === 'Ver Informes') { %>
            <div class="offcanvas offcanvas-start" tabindex="-1" id="mobileFilters">
                <div class="offcanvas-header">
                    <h5 class="offcanvas-title">Filtros de búsqueda</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
                </div>
                <div class="offcanvas-body">
                    <div class="busqueda-informes">
                        <div class="dropdown mb-2 w-100">
                            <button class="btn btn-area dropdown-toggle w-100" type="button" id="dropdownPeriodoMobile" data-bs-toggle="dropdown" aria-expanded="false">Período</button>
                            <ul class="dropdown-menu w-100" aria-labelledby="dropdownPeriodoMobile">
                                <li><a class="dropdown-item" href="#">Enero 2025</a></li>
                                <li><a class="dropdown-item" href="#">Febrero 2025</a></li>
                                <li><a class="dropdown-item" href="#">Marzo 2025</a></li>
                                <li><a class="dropdown-item" href="#">Q1 2025</a></li>
                                <li><a class="dropdown-item" href="#">2024</a></li>
                                <li><a class="dropdown-item" href="#">Diciembre 2024</a></li>
                            </ul>
                        </div>
                        <div class="dropdown mb-2 w-100">
                            <button class="btn btn-area dropdown-toggle w-100" type="button" id="dropdownAreaMobile" data-bs-toggle="dropdown" aria-expanded="false">Área</button>
                            <ul class="dropdown-menu w-100" aria-labelledby="dropdownAreaMobile">
                                <li><a class="dropdown-item" href="#">Todas las áreas</a></li>
                                <li><a class="dropdown-item" href="#">Finanzas y Contabilidad</a></li>
                                <li><a class="dropdown-item" href="#">Recursos Humanos</a></li>
                                <li><a class="dropdown-item" href="#">Tecnologías de la Información</a></li>
                                <li><a class="dropdown-item" href="#">Mercadotecnia</a></li>
                                <li><a class="dropdown-item" href="#">Departamento de Logística</a></li>
                                <li><a class="dropdown-item" href="#">Producción / Operaciones</a></li>
                            </ul>
                        </div>
                        <div class="dropdown mb-2 w-100">
                            <button class="btn btn-nuevos dropdown-toggle w-100" type="button" id="dropdownEstadoMobile" data-bs-toggle="dropdown" aria-expanded="false">Estado</button>
                            <ul class="dropdown-menu w-100" aria-labelledby="dropdownEstadoMobile">
                                <li><a class="dropdown-item" href="#">Completado</a></li>
                                <li><a class="dropdown-item" href="#">En Proceso</a></li>
                                <li><a class="dropdown-item" href="#">Cancelado</a></li>
                            </ul>
                        </div>
                        <div class="row mb-2">
                            <div class="col-6">
                                <label for="fecha-desde-mobile" class="form-label small">Desde</label>
                                <input type="date" id="fecha-desde-mobile" class="form-control form-control-sm">
                            </div>
                            <div class="col-6">
                                <label for="fecha-hasta-mobile" class="form-label small">Hasta</label>
                                <input type="date" id="fecha-hasta-mobile" class="form-control form-control-sm">
                            </div>
                        </div>
                        <button class="btn btn-buscar w-100" type="button" onclick="buscarInformes()">Buscar</button>
                    </div>
                </div>
            </div>
        <% } %>
    </div>

    <% if (title === 'Ver Informes' || title === 'Estadísticas') { %>
        <div class="fixed-bottom text-end">
            <a href="/inicio-visitante" class="btn btn-inicio btn-lg rounded-pill">
                <i class="bi bi-house-door-fill me-2"></i>Inicio
            </a>
        </div>
    <% } %>

    <%- include('ModalConfirm') %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/sistema.js"></script>
    <script>
        // Función para mostrar toasts (misma implementación que en layouts principales)
        function mostrarToast(mensaje, tipo = 'info') {
            // Crear toast simple visual
            try { console.log(`${tipo.toUpperCase()}: ${mensaje}`); } catch (e) {}
            const toast = document.createElement('div');
            toast.className = `alert alert-${tipo === 'danger' ? 'danger' : tipo === 'success' ? 'success' : 'info'} alert-dismissible fade show position-fixed`;
            toast.style.cssText = 'top: 20px; right: 20px; z-index: 9999; min-width: 300px;';
            toast.innerHTML = `\n                ${mensaje}\n                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>\n            `;
            document.body.appendChild(toast);
            setTimeout(() => { toast.remove(); }, 3000);
        }

        // Función de búsqueda de informes para visitantes
        function buscarInformes() {
            // Implementar lógica de búsqueda
            console.log('Búsqueda de informes');
            mostrarToast('Búsqueda iniciada', 'info');
        }
    </script>
</body>
</html>