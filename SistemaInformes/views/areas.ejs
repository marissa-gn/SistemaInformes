
    <div class="text-center mb-4 mt-3">
        <h2 class="titulo-tabla">
            <i class="bi bi-building me-2"></i>Áreas
        </h2>
    </div>
    <div class="card">
        <div class="card-body p-4">
                <div class="table-scroll">
                <table class="table table-hover text-center data-table">
                        <thead class="text-center">
                            <tr>
                                <th>#</th>
                                <th>Área</th>
                                <th>Descripción</th>
                                <th>
                                    Acciones
                                    <button id="btn-refrescar-areas" class="btn btn-sm btn-outline-secondary btn-icon ms-2" type="button" title="Refrescar lista de áreas" aria-label="Refrescar lista de áreas">
                                        <i class="bi bi-arrow-clockwise"></i>
                                    </button>
                                </th>
                            </tr>
                        </thead>
                        <tbody id="areas-tbody">
                            <% if (areas && areas.length > 0) { %>
                                <% areas.forEach((area, index) => { %>
                                    <tr data-area-id="<%= area.id %>">
                                        <td><%= index + 1 %></td>
                                        <td><%= area.nombre %></td>
                                        <td><%= area.descripcion %></td>
                                        <td>
                                            <div class="d-flex justify-content-center gap-2 nowrap">
                                                <button type="button" 
                                                        class="btn btn-editar btn-sm btn-editar-area btn-min-70" 
                                                        data-bs-toggle="modal" 
                                                        data-bs-target="#modalAreas"
                                                        data-area-id="<%= area.id %>"
                                                        data-area-nombre="<%= area.nombre %>"
                                                        data-area-descripcion="<%= area.descripcion || '' %>">
                                                    Editar
                                                </button>
                                                <button type="button" 
                                                        class="btn btn-danger btn-sm btn-eliminar-area btn-min-70" 
                                                        data-area-id="<%= area.id %>"
                                                        data-area-nombre="<%= area.nombre %>">
                                                    Eliminar
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="4" class="text-center text-muted">No hay áreas registradas</td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            <div class="w-100 d-flex justify-content-start mt-3">
                <button type="button" 
                        class="btn btn-anadir-area" 
                        data-bs-toggle="modal" 
                        data-bs-target="#modalAreas">
                    Añadir área
                </button>
            </div>
        </div>
    </div>
    <!-- Incluye el modal de áreas -->
    <%- include('ModalAreas') %>